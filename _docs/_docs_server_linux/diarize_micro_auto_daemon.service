### With checking Redis installed, comparing minimal required Redis version,
### auto-installing or auto-updating Redis, auto-starting Redis and starting
### the service itself
### NOTE: script uncommented and working
[Unit]
Description=DiarizationTransformer_API_MSvc
After=network.target redis-server.service
Requires=redis-server.service
[Service]
User=octadim
WorkingDirectory=/home/octadim/PycharmProjects/DiarizationTransformer_API_MSvc
ExecStartPre=/bin/bash -c '/home/octadim/PycharmProjects/DiarizationTransformer_API_MSvc/db_redis/check_version_auto_install_redis.sh'
ExecStart=/home/octadim/PycharmProjects/DiarizationTransformer_API_MSvc/.venv31211_pyann/bin/python3.12 /home/octadim/PycharmProjects/DiarizationTransformer_API_MSvc/main.py
Restart=always
RestartSec=180
Type=simple
StandardOutput=journal
StandardError=journal
#StandardOutput=file:/var/log/diarize/diarize.log
#StandardError=file:/var/log/diarize/diarize.err
LogLevelMax=debug
[Install]
WantedBy=multi-user.target


